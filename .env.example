# Local development environment for a source checkout.
#
#   cp .env.example .env
#   set -a; . ./.env; set +a      # export everything into your shell
#   docker compose up -d && go run ./cmd/graph migrate
#
# .env is git-ignored. Never commit real secrets. Every variable the binary
# reads is documented in docs/configuration.md.

# --- Datastores (match the root docker-compose.yml; dev-only credentials) ---
DATABASE_URL=postgres://graph:graph@localhost:5432/graph?sslmode=disable
CLICKHOUSE_URL=clickhouse://graph:graph@localhost:9000/graph

# --- Required: master key for encrypting connector credentials ---
# Must be base64 of exactly 32 bytes. Generate one and paste it below:
#   head -c32 /dev/urandom | base64
# Keep the same key across restarts, or stored credentials become unreadable.
GRAPH_SECRET_KEY=

# --- HTTP listen address ---
ADDR=:8080

# --- Plain-http local dev ---
# Safari refuses the Secure session cookie on plain http://localhost (Chrome and
# Firefox accept it), so sign-in loops back to the login page without this.
# DEV ONLY: never set it on a real deployment.
COOKIE_INSECURE=true

# --- Graph engine (Ladybug; needs scripts/fetch-ladybug.sh) ---
# Without these the worker opens no graph and serve has no Cypher: raw Cypher,
# saved queries, NL-to-Cypher and the internet-reach scoring signal are off, and
# Explore falls back to a ClickHouse BFS. Both processes log a WARN saying so.
# LADYBUG_INTERNAL_PORT turns the engine on in the worker and is the port of its
# internal RPC; serve reaches it at LADYBUG_RPC_URL.
LADYBUG_INTERNAL_PORT=8090
LADYBUG_RPC_URL=http://localhost:8090
# Shared by worker and serve. Set it: left empty, the worker refuses to serve
# the RPC (it logs an error) and serve warns at startup that its graph calls
# will fail. Use its own value, not GRAPH_SECRET_KEY:
#   openssl rand -hex 32
LADYBUG_RPC_SECRET=
# Warm-start snapshot (the default /data/ladybug is not writable on a laptop).
# .ladybug/ is git-ignored.
LADYBUG_SNAPSHOT_PATH=./.ladybug/snapshot.gz

# --- Small footprint (skip the heavy scanners on a laptop) ---
# On/off switches: 1/true/yes/on or 0/false/no/off (case-insensitive, unset =
# off); any other value stops the pod.
#SCAN_WORKER_DISABLED=true
#IMAGE_SCAN_DISABLED=true

# --- Outbound connections (see docs/configuration.md#network-egress) ---
# These are on by default. Each switch takes 1/true/yes/on to turn the
# connection off (0/false/no/off or unset leaves it on); any other value stops
# the pod, so a typo never leaves a feed silently on. OFFLINE_MODE turns off
# every one of them at once. The nuclei SDK's own version check to api.pdtm.sh
# needs no switch: Vulngraph refuses it in-process in every mode.
#OFFLINE_MODE=true
# CISA KEV catalog (www.cisa.gov):
#INTEL_KEV_DISABLED=true
# EPSS scores (epss.cyentia.com):
#INTEL_EPSS_DISABLED=true
# OpenSSF malicious-packages feed (api.github.com, raw.githubusercontent.com):
#INTEL_MALFEED_DISABLED=true
# Package names and versions sent to api.osv.dev; also stops image scanning:
#INTEL_OSV_DISABLED=true
# Amazon Linux advisories (cdn.amazonlinux.com repository metadata, no data sent):
#INTEL_ALAS_DISABLED=true
# Oracle Linux errata (yum.oracle.com repository metadata, no data sent):
#INTEL_ELSA_DISABLED=true
# Monitored domain names sent to crt.sh:
#DOMAIN_MONITOR_DISABLED=true
# HTTP probe of hostnames from your collected DNS records:
#TAKEOVER_PROBE_DISABLED=true
# Download of the pinned, checksum-verified nuclei-templates release from
# GitHub (scans then need it installed already, or NUCLEI_TEMPLATES_DIR):
#NUCLEI_TEMPLATES_DOWNLOAD_DISABLED=true
# Pre-populated nuclei templates (also stops the download):
#NUCLEI_TEMPLATES_DIR=/opt/nuclei-templates
# A different nuclei-templates release than the pinned one: its tag and the
# sha256 of https://github.com/projectdiscovery/nuclei-templates/archive/refs/tags/<tag>.tar.gz
#NUCLEI_TEMPLATES_VERSION=v10.5.1
#NUCLEI_TEMPLATES_SHA256=
# HTTP proxy for the nuclei-templates download only; HTTPS_PROXY/HTTP_PROXY
# are never used for it (nuclei would send scan traffic through them too):
#NUCLEI_TEMPLATES_PROXY=http://proxy.internal:3128
#
# Off by default (opt in; OFFLINE_MODE keeps it off):
# nuclei out-of-band (interactsh) testing, which makes scan targets call back to
# ProjectDiscovery's public oast.* servers. Without it, templates that detect a
# vulnerability only through a callback cannot match.
#NUCLEI_INTERACTSH_ENABLED=true

# --- LLM features (optional; see docs/llm-providers.md) ---
# Anthropic:
#LLM_PROVIDER=anthropic
#LLM_API_KEY=
# OpenAI-compatible local model (Ollama):
#LLM_PROVIDER=openai
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_MODEL=llama3.1
#LLM_API_KEY=ollama

# --- Local AWS ingest (optional) ---
# The AWS SDK reads its own credentials; the app does not. Point it at a
# profile in ~/.aws/config, ideally a read-only one:
#AWS_PROFILE=my-readonly-profile
