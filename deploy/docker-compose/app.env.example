# Copy to app.env in this directory (deploy/docker-compose) to set
# application settings: every variable here reaches serve and worker
# (env_file), so any setting in docs/configuration.md can be added. Without an
# app.env the stack still starts, with those features off.
#
# Do not put the datastore passwords here: they belong in .env, which only
# docker-compose.yml reads.

# Optional. An LLM provider powers the reasoning agent, chat, NL→query
# translation and AI template generation; without one those features are off
# and everything else works. Any provider — see docs/llm-providers.md. Pick one:
#
#   Anthropic:            ANTHROPIC_API_KEY=sk-ant-...
#   OpenAI:               LLM_PROVIDER=openai LLM_API_KEY=sk-... LLM_MODEL=gpt-5
#   Gateway / OpenRouter: LLM_PROVIDER=openai LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_API_KEY=... LLM_MODEL=...
#   Local (Ollama):       LLM_BASE_URL=http://host.docker.internal:11434/v1 LLM_MODEL=qwen3:32b
#
# host.docker.internal is the host machine (docker-compose.yml maps it on Linux
# too). Ollama listens on 127.0.0.1 only by default, which the containers
# cannot reach on Linux: start it with OLLAMA_HOST=0.0.0.0 (it then listens on
# every interface, so keep port 11434 firewalled from other machines).
ANTHROPIC_API_KEY=
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_FAST_MODEL=

# Optional. Email approval requests (single-use approve/deny links) when a
# remediation decision is parked for approval. Off unless SMTP_HOST is set.
# APPROVAL_TOKEN_SECRET must be at least 32 bytes (openssl rand -hex 32); the
# worker signs links with it and serve verifies them; both read this file.
# APPROVAL_BASE_URL is the URL users open Vulngraph at.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_TO=
# Dangerous: true sends approval emails, whose links are bearer credentials,
# unencrypted when the server offers no STARTTLS. Leave false unless the relay
# is on this host or a trusted private link (docs/configuration.md).
# SMTP_ALLOW_PLAINTEXT=false
# APPROVAL_BASE_URL=http://localhost:8080
# APPROVAL_TOKEN_SECRET=

# Optional. Safari refuses the Secure session cookie on plain http://localhost
# (Chrome and Firefox accept it), so signing in loops back to the login page.
# Set this ONLY for that local plain-http case — never behind a real hostname.
# COOKIE_INSECURE=true
